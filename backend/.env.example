# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_KEY=your_service_role_or_secret_key

# AI — v1 uses Gemini Flash (required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: switch provider later (requires pip install openai)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Backend JWT signing (generate: openssl rand -hex 32)
SECRET_KEY=

# App
DEBUG=True
REDIS_URL=redis://localhost:6379

# --- Local dev tokens (optional, for curl/Postman) ---
# Run: ./scripts/refresh_dev_tokens.sh  (requires uvicorn running)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
DEV_SUPABASE_ACCESS_TOKEN=
DEV_BACKEND_JWT=
